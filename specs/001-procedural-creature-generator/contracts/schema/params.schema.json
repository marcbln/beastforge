{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beastforge.dev/schema/params.schema.json",
  "title": "beastforge recipe parameters (params --json)",
  "description": "Declared knobs with types, defaults, units, and limits, without generating the creature (FR-003, US1 scenario 1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_version", "status", "recipe", "name", "params"],
  "properties": {
    "schema_version": { "const": "1" },
    "tool_version": { "type": "string" },
    "status": { "const": "ok" },
    "recipe": { "type": "string", "description": "Resolved recipe path." },
    "name": { "type": "string" },
    "params": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "default", "description"],
        "properties": {
          "name": { "type": "string" },
          "type": { "enum": ["int", "float", "bool", "enum", "string"] },
          "default": { "type": ["string", "number", "boolean"] },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "values": { "type": "array", "items": { "type": ["string", "number", "boolean"] } },
          "unit": { "type": "string" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
