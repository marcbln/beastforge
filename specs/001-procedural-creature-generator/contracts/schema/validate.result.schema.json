{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beastforge.dev/schema/validate.result.schema.json",
  "title": "beastforge validation result (validate --json)",
  "description": "The gate result. stable finding vocabulary, exact location, expected and actual values, and a remedy (FR-034/035/036/037, SC-004).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_version", "status", "valid", "scope", "findings", "summary"],
  "properties": {
    "schema_version": { "const": "1" },
    "tool_version": { "type": "string" },
    "status": { "enum": ["ok", "invalid"] },
    "valid": { "type": "boolean" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["recipe", "library"] },
        "recipe": { "type": "string", "description": "Present when kind = recipe." },
        "creatures": { "type": "array", "items": { "type": "string" } }
      }
    },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errors", "warnings", "creatures_checked"],
      "properties": {
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "creatures_checked": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "location", "message", "expected", "actual", "remedy"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "severity": { "enum": ["error", "warning"] },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["recipe", "path"],
          "properties": {
            "recipe": { "type": "string" },
            "path": { "type": "string", "description": "Field path, e.g. surfaces[1].bones[2]." }
          }
        },
        "message": { "type": "string", "minLength": 1 },
        "expected": {},
        "actual": {},
        "remedy": { "type": "string", "minLength": 1 },
        "suggestion": { "type": "string" }
      }
    }
  }
}
