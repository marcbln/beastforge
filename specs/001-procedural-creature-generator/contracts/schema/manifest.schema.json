{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beastforge.dev/schema/manifest.schema.json",
  "title": "beastforge creature manifest",
  "description": "The sidecar gameplay contract emitted next to <name>.glb. schemaVersion is MAJOR.MINOR: consumers on the same major ignore unknown fields, consumers on a different major must reject with manifest-schema-unsupported (FR-029/030/031/032/033).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "toolVersion", "generator", "creature", "provenance",
    "units", "upAxis", "forwardAxis", "bounds", "suggestedScale",
    "skeleton", "clips", "events", "sockets", "volumes", "phases",
    "materials", "playback", "budgets"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Manifest schema, major.minor. v1 starts at 1.0."
    },
    "toolVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$",
      "description": "beastforge version that produced the package."
    },
    "generator": { "const": "beastforge" },
    "creature": { "$ref": "#/$defs/creature" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "units": { "const": "m", "description": "Metres (FR-027)." },
    "upAxis": { "const": "Y" },
    "forwardAxis": { "const": "-Z" },
    "bounds": { "$ref": "#/$defs/bounds" },
    "suggestedScale": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Consumer scale hint; v1 creatures are authored in metres."
    },
    "skeleton": { "$ref": "#/$defs/skeleton" },
    "clips": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/clip" },
      "description": "Must contain the reserved clips idle, locomotion, attack, hurt, death; extra clips are allowed."
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" },
      "description": "Authoritative gameplay timing; keyframes are never inspected for timing (FR-031)."
    },
    "sockets": { "type": "array", "items": { "$ref": "#/$defs/socket" } },
    "volumes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/volume" }
    },
    "phases": { "type": "array", "items": { "$ref": "#/$defs/phase" } },
    "materials": {
      "type": "array",
      "items": { "$ref": "#/$defs/material" },
      "description": "Empty when the recipe declares no materials."
    },
    "playback": { "$ref": "#/$defs/playback" },
    "budgets": { "$ref": "#/$defs/budgets" }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "creature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "category", "description"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$", "maxLength": 64 },
        "category": { "enum": ["boss", "quadruped", "swarm", "other"] },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipePath", "recipeSha256", "recipeVersion", "resolvedParams", "toolVersion", "texforgeVersion"],
      "properties": {
        "recipePath": { "type": "string", "minLength": 1 },
        "recipeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "recipeVersion": { "type": "string" },
        "resolvedParams": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
        },
        "toolVersion": { "type": "string" },
        "texforgeVersion": { "type": "string" }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "$ref": "#/$defs/vec3" },
        "max": { "$ref": "#/$defs/vec3" }
      }
    },
    "skeleton": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "joints"],
      "properties": {
        "root": { "type": "string" },
        "joints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "parent"],
            "properties": {
              "name": { "type": "string" },
              "parent": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "duration", "loop", "generator"],
      "properties": {
        "name": { "type": "string" },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "loop": { "type": "boolean" },
        "generator": {
          "enum": ["breathe", "gait", "hover-bob", "recoil", "telegraph-attack", "death-collapse"]
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clip", "time", "name"],
      "properties": {
        "clip": { "type": "string", "description": "Must name an existing clip." },
        "time": { "type": "number", "minimum": 0, "description": "Seconds from clip start; strictly less than the clip duration." },
        "name": { "type": "string" }
      }
    },
    "socket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "target", "offset"],
      "properties": {
        "name": { "type": "string" },
        "target": { "type": "string", "description": "Existing bone/joint name." },
        "offset": { "$ref": "#/$defs/vec3" }
      }
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "center", "extents"],
      "properties": {
        "name": { "type": "string" },
        "role": { "enum": ["hit", "weak-point", "collision"] },
        "center": { "$ref": "#/$defs/vec3" },
        "extents": {
          "type": "array",
          "items": { "type": "number", "exclusiveMinimum": 0 },
          "minItems": 3,
          "maxItems": 3
        },
        "bone": { "type": "string", "description": "Optional follow bone; must exist." }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "threshold"],
      "properties": {
        "name": { "type": "string" },
        "threshold": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "slot", "texture", "metallic", "roughness"],
      "properties": {
        "name": { "type": "string" },
        "slot": { "const": "baseColor" },
        "texture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["recipe", "params", "size", "sha256"],
          "properties": {
            "recipe": { "type": "string", "description": "texforge recipe name, not a path." },
            "params": {
              "type": "object",
              "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
            },
            "size": { "type": "string", "pattern": "^[1-9][0-9]*x[1-9][0-9]*$" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "metallic": { "type": "number", "minimum": 0, "maximum": 1 },
        "roughness": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "playback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventTimeScaling", "warning"],
      "properties": {
        "eventTimeScaling": { "const": "proportional" },
        "warning": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable warning that changing playback rate scales event times proportionally."
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vertices", "bones", "triangles"],
      "properties": {
        "vertices": { "type": "integer", "minimum": 0 },
        "bones": { "type": "integer", "minimum": 0 },
        "triangles": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
