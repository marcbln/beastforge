{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beastforge.dev/schema/recipe.schema.json",
  "title": "beastforge creature recipe (YAML as JSON-compatible data)",
  "description": "Structural schema for one library/<category>/<name>.yaml. Referential rules (reserved clips, required hit volume, boss phases, dangling refs, skin invariants) are enforced by the validation gate, not expressible here (FR-014..FR-028).",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "params", "budgets", "skeleton", "surfaces", "materials", "clips", "volumes"],
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "params": { "type": "array", "items": { "$ref": "#/$defs/param" } },
    "budgets": { "$ref": "#/$defs/budgets" },
    "skeleton": { "$ref": "#/$defs/skeleton" },
    "surfaces": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/surface" } },
    "materials": { "type": "array", "items": { "$ref": "#/$defs/material" } },
    "clips": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/clip" } },
    "sockets": { "type": "array", "items": { "$ref": "#/$defs/socket" } },
    "volumes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/volume" } },
    "phases": { "type": "array", "items": { "$ref": "#/$defs/phase" } }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$", "maxLength": 64 },
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "quat": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "category", "tested_with", "version"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string", "minLength": 1 },
        "category": { "enum": ["boss", "quadruped", "swarm", "other"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "author": { "type": "string" },
        "tested_with": { "type": "string" },
        "version": { "type": "string" },
        "units": { "const": "m" },
        "orientation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["up", "forward"],
          "properties": { "up": { "const": "Y" }, "forward": { "const": "-Z" } }
        }
      }
    },
    "param": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "default", "description"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "type": { "enum": ["int", "float", "bool", "enum", "string"] },
        "default": { "type": ["string", "number", "boolean"] },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "values": { "type": "array", "items": { "type": ["string", "number", "boolean"] } },
        "unit": { "enum": ["m", "rad", "deg", "s", "count", "ratio"] },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vertices", "bones", "triangles"],
      "properties": {
        "vertices": { "type": "integer", "minimum": 1 },
        "bones": { "type": "integer", "minimum": 1 },
        "triangles": { "type": "integer", "minimum": 1 },
        "max_clip_ticks": { "type": "integer", "minimum": 1 }
      }
    },
    "skeleton": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "bones"],
      "properties": {
        "root": { "$ref": "#/$defs/identifier" },
        "bones": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/bone" } },
        "chains": { "type": "array", "items": { "$ref": "#/$defs/chain" } }
      }
    },
    "bone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "parent", "rest"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "parent": { "type": ["string", "null"] },
        "rest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["translation", "rotation", "scale"],
          "properties": {
            "translation": { "$ref": "#/$defs/vec3" },
            "rotation": { "$ref": "#/$defs/quat" },
            "scale": { "$ref": "#/$defs/vec3" }
          }
        }
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bones"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "bones": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identifier" } }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mode", "kind", "bones", "radius"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "mode": { "const": "sweep", "description": "Only sweep in v1; other values are rejected with surface-unsupported-mode." },
        "kind": { "enum": ["limb-tube", "torso-shell", "rigid-part"] },
        "bones": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identifier" } },
        "rigid_bone": { "$ref": "#/$defs/identifier" },
        "rings": { "type": "integer", "minimum": 2 },
        "segments": { "type": "integer", "minimum": 3 },
        "radius": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end"],
              "properties": {
                "start": { "type": "number", "exclusiveMinimum": 0 },
                "end": { "type": "number", "exclusiveMinimum": 0 }
              }
            },
            { "type": "array", "minItems": 1, "items": { "type": "number", "exclusiveMinimum": 0 } }
          ]
        },
        "blend": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.35 },
        "modifiers": { "$ref": "#/$defs/modifiers" },
        "material": { "$ref": "#/$defs/identifier" }
      }
    },
    "modifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taper": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "number", "exclusiveMinimum": 0 },
            "end": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "twist": { "type": "number" },
        "radial_noise": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amplitude", "frequency"],
          "properties": {
            "amplitude": { "type": "number", "minimum": 0 },
            "frequency": { "type": "number", "exclusiveMinimum": 0 },
            "seed": { "type": "integer", "minimum": 0 }
          }
        },
        "squash": { "$ref": "#/$defs/vec3" },
        "scale": { "$ref": "#/$defs/vec3" }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "texture"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "texture": { "type": "string", "description": "texforge recipe name." },
        "params": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
        },
        "size": { "type": "string", "pattern": "^[1-9][0-9]*x[1-9][0-9]*$" },
        "slot": { "const": "baseColor" },
        "metallic": { "type": "number", "minimum": 0, "maximum": 1 },
        "roughness": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "time": { "type": "number", "minimum": 0 },
        "ticks": { "type": "integer", "minimum": 0 }
      },
      "oneOf": [
        { "required": ["time"] },
        { "required": ["ticks"] }
      ],
      "not": { "required": ["time", "ticks"] }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "generator", "loop"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "generator": { "enum": ["breathe", "gait", "hover-bob", "recoil", "telegraph-attack", "death-collapse"] },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "ticks": { "type": "integer", "minimum": 1 },
        "loop": { "type": "boolean" },
        "params": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean", "null", "array"] }
        },
        "events": { "type": "array", "items": { "$ref": "#/$defs/event" } }
      },
      "oneOf": [
        { "required": ["duration"] },
        { "required": ["ticks"] }
      ],
      "not": { "required": ["duration", "ticks"] }
    },
    "socket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bone", "offset"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "bone": { "$ref": "#/$defs/identifier" },
        "offset": { "$ref": "#/$defs/vec3" }
      }
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "center", "extents"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "role": { "enum": ["hit", "weak-point", "collision"] },
        "center": { "$ref": "#/$defs/vec3" },
        "extents": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 }, "minItems": 3, "maxItems": 3 },
        "bone": { "$ref": "#/$defs/identifier" }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "threshold"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "threshold": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 }
      }
    }
  }
}
